# Copy to .env and fill in. Loaded automatically by fastlane (dotenv).

# App Store Connect API key (match + notarization). Needs the Admin role so match can
# create the Developer ID certificate; Developer is enough once it exists (MATCH_READONLY=1).
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=./AuthKey_XXXXXXXXXX.p8

# fastlane match certificate repository
MATCH_GIT_URL=
MATCH_PASSWORD=

# GitHub token with `repo` scope; when set, `release` also publishes a GitHub release.
GITHUB_TOKEN=

# Optional overrides
# TESTFLIGHT_PUBLIC_GROUP=Public
# TESTFLIGHT_SKIP_WAIT=0
# TESTFLIGHT_WAIT_TIMEOUT_SECONDS=3600
# TEAM_ID=H2CJGWVMU4
# BUILD_NUMBER=            # defaults to `git rev-list --count HEAD`
# MATCH_READONLY=0
# GITHUB_REPOSITORY=shonenada-vibe/yatd
# GITHUB_RELEASE_DRAFT=0   # 1 creates a draft (Homebrew can't download drafts)
# HOMEBREW_TAP_DIR=../homebrew-tap
# HOMEBREW_TAP_REPOSITORY=shonenada/homebrew-tap
# ALLOW_DIRTY=0            # 1 allows releasing with uncommitted changes
