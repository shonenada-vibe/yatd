require 'fileutils'

default_platform(:mac)

# Two ways to ship:
# - `release`: the regular build (unsandboxed, uses the `ntn` CLI), Developer ID signed,
#   notarized and zipped, optionally attached to a GitHub release.
# - `beta`: the sandboxed `AppStore` configuration (talks to Notion over HTTPS with an
#   integration token), uploaded to TestFlight.
APP_IDENTIFIER = 'com.shonenada.yatd'
PROJECT = 'YATD.xcodeproj'
SCHEME = 'YATD'
APP_NAME = 'YATD'
ROOT_DIR = File.expand_path('..', __dir__)
BUILD_DIR = File.join(ROOT_DIR, 'build', 'release')
TEAM_ID = ENV.fetch('TEAM_ID', 'H2CJGWVMU4').freeze
SIGNING_IDENTITY = 'Developer ID Application'
GITHUB_REPOSITORY = ENV.fetch('GITHUB_REPOSITORY', 'shonenada-vibe/yatd').freeze
BUILD_TAG_PREFIX = 'build'
CHANGELOG_COMMITS = 10
APP_STORE_CONFIGURATION = 'AppStore'
APP_STORE_PROFILE = "match AppStore #{APP_IDENTIFIER} macos".freeze
PUBLIC_TESTFLIGHT_GROUP = ENV.fetch('TESTFLIGHT_PUBLIC_GROUP', 'Public').to_s.freeze

def require_env!(keys)
  missing = keys.select { |key| ENV[key].to_s.strip.empty? }
  return if missing.empty?

  UI.user_error!("Missing required env: #{missing.join(', ')}")
end

def require_file!(path, label)
  return if File.exist?(path)

  UI.user_error!("Missing file for #{label}: #{path}")
end

def env_bool!(key, default:)
  raw = ENV.fetch(key, default ? '1' : '0').to_s.strip.downcase
  return true if %w[1 true yes y].include?(raw)
  return false if %w[0 false no n].include?(raw)

  UI.user_error!("Invalid boolean for #{key}: #{raw} (use 1/0/true/false/yes/no)")
end

def git_commit_count
  output = `git rev-list --count HEAD 2>&1`.strip
  status = $?.exitstatus
  UI.user_error!("Failed to get git commit count (exit #{status}): #{output}") unless status == 0

  count = output.to_i
  UI.user_error!("Invalid git commit count: #{output}") if count <= 0
  count
end

def build_number
  value = ENV['BUILD_NUMBER'].to_s.strip
  return git_commit_count if value.empty?

  number = Integer(value, 10)
  UI.user_error!('BUILD_NUMBER must be greater than zero') unless number.positive?
  number
rescue ArgumentError
  UI.user_error!("Invalid BUILD_NUMBER: #{value}")
end

# MARKETING_VERSION from project.yml, the source of truth for the generated project.
def marketing_version
  yml = File.read(File.join(ROOT_DIR, 'project.yml'))
  version = yml[/MARKETING_VERSION:\s*"?([0-9][0-9A-Za-z.\-]*)"?/, 1]
  UI.user_error!('MARKETING_VERSION not found in project.yml') if version.to_s.empty?
  version
end

def git_head_sha
  output = `git rev-parse HEAD 2>&1`.strip
  status = $?.exitstatus
  UI.user_error!("Failed to resolve git HEAD (exit #{status}): #{output}") unless status == 0
  output
end

def ensure_clean_git!
  return if env_bool!('ALLOW_DIRTY', default: false)

  status = `git status --porcelain 2>&1`.strip
  UI.user_error!("Working tree has uncommitted changes (set ALLOW_DIRTY=1 to override):\n#{status}") unless status.empty?
end

def recent_git_changelog(limit:)
  output = `git log -n #{limit} --pretty=format:'%s' 2>&1`.strip
  status = $?.exitstatus
  UI.user_error!("Failed to read git log (exit #{status}): #{output}") unless status == 0

  lines = output.lines.map(&:strip).reject(&:empty?)
  UI.user_error!('No Git commits found for changelog') if lines.empty?
  lines.map { |line| "- #{line}" }.join("\n")
end

def build_tag(number)
  "#{BUILD_TAG_PREFIX}-#{number}"
end

def tag_build!(number)
  tag = build_tag(number)
  head = git_head_sha
  tagged_commit = `git rev-list -n 1 #{tag} 2>/dev/null`.strip

  if tagged_commit == head
    UI.message("Git tag already exists: #{tag}")
    return
  end

  unless tagged_commit.empty?
    UI.user_error!("Git tag #{tag} already points to #{tagged_commit}; HEAD is #{head}")
  end

  sh('git', 'tag', '-a', tag, '-m', "Build #{number}")
end

# The .xcodeproj is generated by XcodeGen and is git-ignored, so regenerate it
# before building.
def ensure_project!
  Dir.chdir(ROOT_DIR) { sh('xcodegen', 'generate') }
  require_file!(File.join(ROOT_DIR, PROJECT), 'generated Xcode project')
end

def asc_api_key!
  require_env!(%w[ASC_KEY_ID ASC_KEY_PATH])
  key_path = File.expand_path(ENV.fetch('ASC_KEY_PATH'), ROOT_DIR)
  require_file!(key_path, 'ASC_KEY_PATH')

  options = {
    key_id: ENV.fetch('ASC_KEY_ID'),
    key_filepath: key_path,
    in_house: false
  }
  issuer_id = ENV['ASC_ISSUER_ID'].to_s.strip
  options[:issuer_id] = issuer_id unless issuer_id.empty?
  app_store_connect_api_key(**options)
end

def env_int!(key, default:)
  raw = ENV.fetch(key, default.to_s).to_s.strip
  value = Integer(raw, 10)
  UI.user_error!("Invalid integer for #{key}: #{raw} (must be greater than zero)") unless value.positive?
  value
rescue ArgumentError
  UI.user_error!("Invalid integer for #{key}: #{raw} (must be greater than zero)")
end

def ensure_bundle_id!
  return false if Spaceship::ConnectAPI::BundleId.find(APP_IDENTIFIER)

  UI.message("Registering Bundle ID: #{APP_IDENTIFIER}")
  Spaceship::ConnectAPI::BundleId.create(
    name: APP_NAME,
    platform: 'UNIVERSAL',
    identifier: APP_IDENTIFIER,
    seed_id: TEAM_ID
  )
  true
end

# The App Store Connect API can't create app records, so the first one is made by hand.
def ensure_app_record!
  return if Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)

  UI.user_error!(
    "No App Store Connect app for #{APP_IDENTIFIER}. Create it once at https://appstoreconnect.apple.com/apps " \
    "(＋ → New App → macOS, bundle ID #{APP_IDENTIFIER}), then run `just beta` again."
  )
end

def validate_build_number!(number, api_key:)
  latest = latest_testflight_build_number(
    api_key: api_key,
    app_identifier: APP_IDENTIFIER,
    platform: 'osx',
    initial_build_number: 0
  )
  return UI.message("Build number: #{number} (TestFlight latest: #{latest})") if number > latest

  UI.user_error!(
    "Build number #{number} is not greater than the latest TestFlight build #{latest}. " \
    'Set BUILD_NUMBER to a higher value.'
  )
end

# Sandboxed build signed for the Mac App Store, packaged as a .pkg for upload.
def build_app_store_pkg(number:)
  ensure_project!
  dir = File.join(ROOT_DIR, 'build', 'appstore')
  FileUtils.rm_rf(dir)
  FileUtils.mkdir_p(dir)

  gym(
    project: PROJECT,
    scheme: SCHEME,
    configuration: APP_STORE_CONFIGURATION,
    clean: true,
    export_method: 'app-store',
    export_options: {
      provisioningProfiles: { APP_IDENTIFIER => APP_STORE_PROFILE },
      signingStyle: 'manual'
    },
    archive_path: File.join(dir, "#{APP_NAME}.xcarchive"),
    output_directory: dir,
    # gym appends the extension itself ("YATD.pkg" would become "YATD.pkg.pkg").
    output_name: APP_NAME,
    xcargs: "CURRENT_PROJECT_VERSION=#{number}"
  )

  pkg_path = lane_context[SharedValues::PKG_OUTPUT_PATH] || File.join(dir, "#{APP_NAME}.pkg")
  require_file!(pkg_path, 'App Store package')
  pkg_path
end

def build_app_bundle(number:)
  ensure_project!
  FileUtils.rm_rf(BUILD_DIR)
  FileUtils.mkdir_p(BUILD_DIR)
  archive_path = File.join(BUILD_DIR, "#{APP_NAME}.xcarchive")

  gym(
    project: PROJECT,
    scheme: SCHEME,
    configuration: 'Release',
    clean: true,
    export_method: 'developer-id',
    export_options: {
      signingStyle: 'manual',
      signingCertificate: SIGNING_IDENTITY,
      teamID: TEAM_ID
    },
    archive_path: archive_path,
    output_directory: BUILD_DIR,
    xcargs: [
      "DEVELOPMENT_TEAM=#{TEAM_ID}",
      'CODE_SIGN_STYLE=Manual',
      "CODE_SIGN_IDENTITY=#{SIGNING_IDENTITY.shellescape}",
      # Notarization requires a secure timestamp on every signature.
      'OTHER_CODE_SIGN_FLAGS=--timestamp',
      "CURRENT_PROJECT_VERSION=#{number}"
    ].join(' ')
  )

  app_path = File.join(BUILD_DIR, "#{APP_NAME}.app")
  require_file!(app_path, 'exported app')
  app_path
end

# Zips with ditto so the stapled notarization ticket and extended attributes survive.
def zip_app(app_path, version:, number:)
  zip_path = File.join(BUILD_DIR, "#{APP_NAME}-#{version}-#{number}.zip")
  sh('ditto', '-c', '-k', '--sequesterRsrc', '--keepParent', app_path, zip_path)
  zip_path
end

platform :mac do
  desc 'Sync the Developer ID Application certificate via match'
  lane :sync_certificates do |options|
    require_env!(%w[MATCH_GIT_URL MATCH_PASSWORD])
    api_key = options[:api_key] || asc_api_key!
    match(
      type: 'developer_id',
      platform: 'macos',
      api_key: api_key,
      app_identifier: [APP_IDENTIFIER],
      # No entitlements need a profile; the certificate alone signs the app.
      skip_provisioning_profiles: true,
      readonly: is_ci || env_bool!('MATCH_READONLY', default: false)
    )
  end

  desc 'Sync Mac App Store distribution + installer certificates and the provisioning profile via match'
  lane :sync_appstore_certificates do |options|
    require_env!(%w[MATCH_GIT_URL MATCH_PASSWORD])
    api_key = options[:api_key] || asc_api_key!
    bundle_id_created = ensure_bundle_id!
    match(
      type: 'appstore',
      platform: 'macos',
      api_key: api_key,
      app_identifier: [APP_IDENTIFIER],
      # The .pkg uploaded to App Store Connect is signed with the installer certificate.
      additional_cert_types: ['mac_installer_distribution'],
      readonly: is_ci || env_bool!('MATCH_READONLY', default: false),
      force: bundle_id_created
    )
  end

  desc 'Build the sandboxed App Store variant and upload it to TestFlight; pass upload_only:true to skip external distribution'
  lane :beta do |options|
    upload_only = options[:upload_only].to_s == 'true'
    api_key = asc_api_key!
    ensure_app_record!
    number = build_number
    validate_build_number!(number, api_key: api_key)
    sync_appstore_certificates(api_key: api_key)

    pkg_path = build_app_store_pkg(number: number)
    skip_wait = upload_only || env_bool!('TESTFLIGHT_SKIP_WAIT', default: false)
    pilot_options = {
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: 'osx',
      pkg: pkg_path,
      uses_non_exempt_encryption: false,
      wait_processing_timeout_duration: env_int!('TESTFLIGHT_WAIT_TIMEOUT_SECONDS', default: 3600)
    }
    if skip_wait
      pilot(**pilot_options, skip_waiting_for_build_processing: true)
    else
      pilot(
        **pilot_options,
        skip_waiting_for_build_processing: false,
        distribute_external: true,
        groups: [PUBLIC_TESTFLIGHT_GROUP],
        notify_external_testers: true,
        changelog: recent_git_changelog(limit: CHANGELOG_COMMITS)
      )
    end
    tag_build!(number)
  end

  desc 'Distribute an already-uploaded TestFlight build to the external group'
  lane :distribute do |options|
    api_key = asc_api_key!
    number = options[:build_number] || build_number
    pilot(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: 'osx',
      distribute_only: true,
      build_number: number.to_s,
      distribute_external: true,
      groups: [PUBLIC_TESTFLIGHT_GROUP],
      notify_external_testers: true,
      changelog: recent_git_changelog(limit: CHANGELOG_COMMITS),
      uses_non_exempt_encryption: false
    )
  end

  desc 'Build a Developer ID signed YATD.app into build/release (not notarized)'
  lane :build do
    api_key = asc_api_key!
    sync_certificates(api_key: api_key)
    app_path = build_app_bundle(number: build_number)
    UI.success("Built #{app_path}")
  end

  desc 'Build, sign, notarize and zip a release; tags the commit and optionally publishes a GitHub release'
  lane :release do
    ensure_clean_git!
    api_key = asc_api_key!
    version = marketing_version
    number = build_number
    UI.message("Releasing #{APP_NAME} #{version} (#{number})")
    sync_certificates(api_key: api_key)

    app_path = build_app_bundle(number: number)
    notarize(
      package: app_path,
      api_key: api_key,
      print_log: true
    )
    sh('spctl', '--assess', '--type', 'execute', '--verbose=2', app_path)

    zip_path = zip_app(app_path, version: version, number: number)
    tag_build!(number)
    UI.success("Notarized release: #{zip_path}")

    if ENV['GITHUB_TOKEN'].to_s.strip.empty?
      UI.message('GITHUB_TOKEN not set; skipping GitHub release. Run `fastlane mac publish` later to upload.')
    else
      publish(zip_path: zip_path, version: version, number: number)
    end
  end

  desc 'Upload a notarized zip to a GitHub release (draft unless GITHUB_RELEASE_DRAFT=0)'
  lane :publish do |options|
    require_env!(%w[GITHUB_TOKEN])
    version = options[:version] || marketing_version
    number = (options[:number] || build_number).to_i
    zip_path = options[:zip_path] || File.join(BUILD_DIR, "#{APP_NAME}-#{version}-#{number}.zip")
    require_file!(zip_path, 'release zip (run `fastlane mac release` first)')

    tag = build_tag(number)
    sh('git', 'push', 'origin', tag)
    set_github_release(
      repository_name: GITHUB_REPOSITORY,
      api_token: ENV.fetch('GITHUB_TOKEN'),
      name: "#{APP_NAME} #{version} (#{number})",
      tag_name: tag,
      commitish: git_head_sha,
      description: recent_git_changelog(limit: CHANGELOG_COMMITS),
      upload_assets: [zip_path],
      is_draft: env_bool!('GITHUB_RELEASE_DRAFT', default: true)
    )
  end
end
